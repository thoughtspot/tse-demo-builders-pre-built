      "homePageType": "html",
      "homePageValue": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Commercial Assurance - Commercial Insurance Analytics</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background-color: #f8fafc;\n            color: #1f2937;\n            line-height: 1.6;\n        }\n\n        .header {\n            background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 50%, #3b82f6 100%);\n            color: white;\n            padding: 2rem 1rem;\n            box-shadow: 0 4px 6px rgba(30, 58, 138, 0.1);\n        }\n\n        .header-content {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .logo {\n            font-size: 2rem;\n            font-weight: 700;\n            margin-bottom: 0.5rem;\n            letter-spacing: -0.5px;\n        }\n\n        .tagline {\n            font-size: 1rem;\n            opacity: 0.95;\n            font-weight: 300;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n\n        .welcome-section {\n            background: white;\n            border-radius: 12px;\n            padding: 2.5rem;\n            margin-bottom: 2rem;\n            box-shadow: 0 2px 8px rgba(30, 58, 138, 0.08);\n            border-left: 4px solid #1d4ed8;\n        }\n\n        .welcome-section h1 {\n            color: #1f2937;\n            font-size: 2rem;\n            margin-bottom: 1rem;\n            font-weight: 600;\n        }\n\n        .welcome-section p {\n            color: #4b5563;\n            font-size: 1.1rem;\n            line-height: 1.8;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            font-size: 1.5rem;\n            color: #1f2937;\n            margin-bottom: 1.5rem;\n            font-weight: 600;\n            display: flex;\n            align-items: center;\n        }\n\n        .section-title::before {\n            content: '';\n            width: 4px;\n            height: 24px;\n            background: #1d4ed8;\n            margin-right: 12px;\n            border-radius: 2px;\n        }\n\n        .kpi-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 1.5rem;\n            margin-bottom: 2rem;\n        }\n\n        .kpi-card {\n            background: white;\n            border-radius: 12px;\n            padding: 1.75rem;\n            box-shadow: 0 2px 8px rgba(30, 58, 138, 0.08);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            border-top: 3px solid #1d4ed8;\n        }\n\n        .kpi-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 8px 16px rgba(30, 58, 138, 0.15);\n        }\n\n        .kpi-card.accent-1 {\n            border-top-color: #1d4ed8;\n        }\n\n        .kpi-card.accent-2 {\n            border-top-color: #1e3a8a;\n        }\n\n        .kpi-card.accent-3 {\n            border-top-color: #3b82f6;\n        }\n\n        .kpi-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin-bottom: 1rem;\n        }\n\n        .kpi-title {\n            font-size: 0.9rem;\n            color: #6b7280;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n            font-weight: 500;\n        }\n\n        .kpi-icon {\n            width: 40px;\n            height: 40px;\n            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);\n            border-radius: 10px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 1.2rem;\n            font-weight: bold;\n        }\n\n        .kpi-value {\n            font-size: 2.5rem;\n            font-weight: 700;\n            color: #1f2937;\n            margin-bottom: 0.5rem;\n        }\n\n        .kpi-change {\n            font-size: 0.9rem;\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .kpi-change.positive {\n            color: #10b981;\n        }\n\n        .kpi-change.negative {\n            color: #ef4444;\n        }\n\n        .kpi-change-icon {\n            font-weight: bold;\n        }\n\n        .quick-stats {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 1rem;\n            margin-top: 2rem;\n        }\n\n        .stat-item {\n            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);\n            padding: 1.25rem;\n            border-radius: 10px;\n            border: 1px solid #e2e8f0;\n        }\n\n        .stat-label {\n            font-size: 0.85rem;\n            color: #6b7280;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n        }\n\n        .stat-value {\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: #1d4ed8;\n        }\n\n        @media (max-width: 768px) {\n            .header {\n                padding: 1.5rem 1rem;\n            }\n\n            .logo {\n                font-size: 1.5rem;\n            }\n\n            .welcome-section {\n                padding: 1.5rem;\n            }\n\n            .welcome-section h1 {\n                font-size: 1.5rem;\n            }\n\n            .welcome-section p {\n                font-size: 1rem;\n            }\n\n            .kpi-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .kpi-value {\n                font-size: 2rem;\n            }\n\n            .quick-stats {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        .footer {\n            text-align: center;\n            padding: 2rem 1rem;\n            color: #6b7280;\n            font-size: 0.9rem;\n        }\n    </style>\n</head>\n<body>\n    <header class=\"header\">\n        <div class=\"header-content\">\n            <div class=\"logo\">Commercial Assurance</div>\n            <div class=\"tagline\">Commercial Insurance Analytics Platform</div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <section class=\"welcome-section\">\n            <h1>Welcome to Commercial Assurance Analytics</h1>\n            <p>\n                Insurance leaders today face increasing challenges &mdash; rising loss costs and catastrophe exposure eroding underwriting margins, intensifying competition squeezing new business growth and retention, and legacy data silos making it harder to act on the insights that matter. The leaders pulling ahead are those who can connect the dots across their business &mdash; from new business to policy renewals to underwriting performance and claims close &mdash; in real time.\n            </p>\n            <p>\n                This insurance solution demo shows how insurance leaders can use agentic analytics to address these challenges. This Liveboard is organized into four key use cases: New Business, Policy Renewals, Underwriting Performance, and Claims Close.\n            </p>\n        </section>\n\n        <h2 class=\"section-title\">Key Performance Indicators</h2>\n\n        <div class=\"kpi-grid\">\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Gross Written Premium</div>\n                    <div class=\"kpi-icon\">$</div>\n                </div>\n                <div class=\"kpi-value\">$2.8B</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>6.2% vs last year</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Combined Ratio</div>\n                    <div class=\"kpi-icon\">%</div>\n                </div>\n                <div class=\"kpi-value\">96.2%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9660;</span>\n                    <span>2.1pts improvement vs prior year</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Loss Ratio</div>\n                    <div class=\"kpi-icon\">&#128202;</div>\n                </div>\n                <div class=\"kpi-value\">61.4%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9660;</span>\n                    <span>1.8pts improvement vs prior year</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">New Business Premium</div>\n                    <div class=\"kpi-icon\">&#127970;</div>\n                </div>\n                <div class=\"kpi-value\">$142M</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>11.3% vs last year</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Policy Retention Rate</div>\n                    <div class=\"kpi-icon\">&#128260;</div>\n                </div>\n                <div class=\"kpi-value\">87.3%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>1.5% improvement vs last year</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Claims Close Rate</div>\n                    <div class=\"kpi-icon\">&#10003;</div>\n                </div>\n                <div class=\"kpi-value\">94.1%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>2.8% improvement vs last year</span>\n                </div>\n            </div>\n        </div>\n\n        <h2 class=\"section-title\">Quick Statistics</h2>\n\n        <div class=\"quick-stats\">\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Active Policies</div>\n                <div class=\"stat-value\">48,291</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Open Claims</div>\n                <div class=\"stat-value\">3,847</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Renewals This Month</div>\n                <div class=\"stat-value\">2,156</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Avg Days to Close</div>\n                <div class=\"stat-value\">18.4</div>\n            </div>\n        </div>\n    </main>\n\n    <footer class=\"footer\">\n        <p>&copy; 2025 Commercial Assurance. All rights reserved. | Commercial Insurance Analytics</p>\n    </footer>\n</body>\n</html>",
