      "homePageValue": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Forsite - IoT Manufacturing Analytics</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background-color: #f5f7fa;\n            color: #1f2937;\n            line-height: 1.6;\n        }\n\n        .header {\n            background: linear-gradient(135deg, #1a4a6b 0%, #2a6496 50%, #3a7abd 100%);\n            color: white;\n            padding: 2rem 1rem;\n            box-shadow: 0 4px 6px rgba(26, 74, 107, 0.15);\n        }\n\n        .header-content {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .logo {\n            font-size: 2rem;\n            font-weight: 700;\n            margin-bottom: 0.5rem;\n            letter-spacing: -0.5px;\n        }\n\n        .tagline {\n            font-size: 1rem;\n            opacity: 0.95;\n            font-weight: 300;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n\n        .welcome-section {\n            background: white;\n            border-radius: 12px;\n            padding: 2.5rem;\n            margin-bottom: 2rem;\n            box-shadow: 0 2px 8px rgba(26, 74, 107, 0.08);\n            border-left: 4px solid #1a4a6b;\n        }\n\n        .welcome-section h1 {\n            color: #1f2937;\n            font-size: 2rem;\n            margin-bottom: 1rem;\n            font-weight: 600;\n        }\n\n        .welcome-section p {\n            color: #4b5563;\n            font-size: 1.1rem;\n            line-height: 1.8;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            font-size: 1.5rem;\n            color: #1f2937;\n            margin-bottom: 1.5rem;\n            font-weight: 600;\n            display: flex;\n            align-items: center;\n        }\n\n        .section-title::before {\n            content: '';\n            width: 4px;\n            height: 24px;\n            background: #1a4a6b;\n            margin-right: 12px;\n            border-radius: 2px;\n        }\n\n        .kpi-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 1.5rem;\n            margin-bottom: 2rem;\n        }\n\n        .kpi-card {\n            background: white;\n            border-radius: 12px;\n            padding: 1.75rem;\n            box-shadow: 0 2px 8px rgba(26, 74, 107, 0.08);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            border-top: 3px solid #1a4a6b;\n        }\n\n        .kpi-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 8px 16px rgba(26, 74, 107, 0.15);\n        }\n\n        .kpi-card.accent-1 {\n            border-top-color: #1a4a6b;\n        }\n\n        .kpi-card.accent-2 {\n            border-top-color: #2a6496;\n        }\n\n        .kpi-card.accent-3 {\n            border-top-color: #f97316;\n        }\n\n        .kpi-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin-bottom: 1rem;\n        }\n\n        .kpi-title {\n            font-size: 0.9rem;\n            color: #6b7280;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n            font-weight: 500;\n        }\n\n        .kpi-icon {\n            width: 40px;\n            height: 40px;\n            background: linear-gradient(135deg, #1a4a6b 0%, #3a7abd 100%);\n            border-radius: 10px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 1.2rem;\n            font-weight: bold;\n        }\n\n        .kpi-card.accent-3 .kpi-icon {\n            background: linear-gradient(135deg, #ea580c 0%, #f97316 100%);\n        }\n\n        .kpi-value {\n            font-size: 2.5rem;\n            font-weight: 700;\n            color: #1f2937;\n            margin-bottom: 0.5rem;\n        }\n\n        .kpi-change {\n            font-size: 0.9rem;\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .kpi-change.positive {\n            color: #10b981;\n        }\n\n        .kpi-change.negative {\n            color: #ef4444;\n        }\n\n        .kpi-change.warning {\n            color: #f97316;\n        }\n\n        .kpi-change-icon {\n            font-weight: bold;\n        }\n\n        .quick-stats {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 1rem;\n            margin-top: 2rem;\n        }\n\n        .stat-item {\n            background: linear-gradient(135deg, #f5f7fa 0%, #edf2f7 100%);\n            padding: 1.25rem;\n            border-radius: 10px;\n            border: 1px solid #e5e7eb;\n        }\n\n        .stat-label {\n            font-size: 0.85rem;\n            color: #6b7280;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n        }\n\n        .stat-value {\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: #1a4a6b;\n        }\n\n        .footer {\n            text-align: center;\n            padding: 2rem 1rem;\n            color: #6b7280;\n            font-size: 0.9rem;\n        }\n\n        @media (max-width: 768px) {\n            .header { padding: 1.5rem 1rem; }\n            .logo { font-size: 1.5rem; }\n            .welcome-section { padding: 1.5rem; }\n            .welcome-section h1 { font-size: 1.5rem; }\n            .welcome-section p { font-size: 1rem; }\n            .kpi-grid { grid-template-columns: 1fr; }\n            .kpi-value { font-size: 2rem; }\n            .quick-stats { grid-template-columns: 1fr; }\n        }\n    </style>\n</head>\n<body>\n    <header class=\"header\">\n        <div class=\"header-content\">\n            <div class=\"logo\">Forsite</div>\n            <div class=\"tagline\">IoT Manufacturing Analytics Platform</div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <section class=\"welcome-section\">\n            <h1>Welcome to Forsite Analytics</h1>\n            <p>\n                Unplanned machine downtime costs manufacturers hundreds of millions annually.\n                Forsite transforms raw IoT telemetry into actionable intelligence — surfacing\n                failing machines before they fail and enabling predictive maintenance at scale.\n            </p>\n            <p>\n                Monitor criticality scores, vibration trends, and environmental conditions across\n                every plant in real time. Empower COOs, plant managers, and reliability engineers\n                with the data they need to eliminate downtime and protect margins.\n            </p>\n        </section>\n\n        <h2 class=\"section-title\">Key Performance Indicators</h2>\n\n        <div class=\"kpi-grid\">\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Machine Uptime</div>\n                    <div class=\"kpi-icon\">⚙</div>\n                </div>\n                <div class=\"kpi-value\">97.4%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>1.8% vs last quarter</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Avg Criticality Score</div>\n                    <div class=\"kpi-icon\">!</div>\n                </div>\n                <div class=\"kpi-value\">3.2</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▼</span>\n                    <span>0.4 below alert threshold</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">High-Risk Alerts</div>\n                    <div class=\"kpi-icon\">⚠</div>\n                </div>\n                <div class=\"kpi-value\">28</div>\n                <div class=\"kpi-change warning\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>Requires immediate review</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Maintenance Savings</div>\n                    <div class=\"kpi-icon\">$</div>\n                </div>\n                <div class=\"kpi-value\">$4.7M</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>YTD cost avoidance</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Active Plants</div>\n                    <div class=\"kpi-icon\">🏭</div>\n                </div>\n                <div class=\"kpi-value\">18</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>2 new plants onboarded</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Sensor Coverage</div>\n                    <div class=\"kpi-icon\">📡</div>\n                </div>\n                <div class=\"kpi-value\">99.1%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>12,480 sensors active</span>\n                </div>\n            </div>\n        </div>\n\n        <h2 class=\"section-title\">Quick Statistics</h2>\n\n        <div class=\"quick-stats\">\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Open Work Orders</div>\n                <div class=\"stat-value\">143</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Scheduled PMs Today</div>\n                <div class=\"stat-value\">12</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Avg Machine Age</div>\n                <div class=\"stat-value\">8.3 yrs</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Energy Cost / Unit</div>\n                <div class=\"stat-value\">$0.043</div>\n            </div>\n        </div>\n    </main>\n\n    <footer class=\"footer\">\n        <p>&copy; 2024 Forsite. All rights reserved. | IoT Manufacturing Analytics</p>\n    </footer>\n</body>\n</html>",
