      "homePageType": "html",
      "homePageValue": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Meridian Capital - Corporate Finance Analytics</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background-color: #f7fafc;\n            color: #1f2937;\n            line-height: 1.6;\n        }\n\n        .header {\n            background: linear-gradient(135deg, #0f2044 0%, #1a3a6b 50%, #2d5a8e 100%);\n            color: white;\n            padding: 2rem 1rem;\n            box-shadow: 0 4px 6px rgba(15, 32, 68, 0.2);\n        }\n\n        .header-content {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .logo {\n            font-size: 2rem;\n            font-weight: 700;\n            margin-bottom: 0.5rem;\n            letter-spacing: -0.5px;\n        }\n\n        .tagline {\n            font-size: 1rem;\n            opacity: 0.85;\n            font-weight: 300;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n\n        .welcome-section {\n            background: white;\n            border-radius: 12px;\n            padding: 2.5rem;\n            margin-bottom: 2rem;\n            box-shadow: 0 2px 8px rgba(15, 32, 68, 0.08);\n            border-left: 4px solid #1a3a6b;\n        }\n\n        .welcome-section h1 {\n            color: #1f2937;\n            font-size: 2rem;\n            margin-bottom: 1rem;\n            font-weight: 600;\n        }\n\n        .welcome-section p {\n            color: #4b5563;\n            font-size: 1.1rem;\n            line-height: 1.8;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            font-size: 1.5rem;\n            color: #1f2937;\n            margin-bottom: 1.5rem;\n            font-weight: 600;\n            display: flex;\n            align-items: center;\n        }\n\n        .section-title::before {\n            content: '';\n            width: 4px;\n            height: 24px;\n            background: #1a3a6b;\n            margin-right: 12px;\n            border-radius: 2px;\n        }\n\n        .kpi-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 1.5rem;\n            margin-bottom: 2rem;\n        }\n\n        .kpi-card {\n            background: white;\n            border-radius: 12px;\n            padding: 1.75rem;\n            box-shadow: 0 2px 8px rgba(15, 32, 68, 0.08);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            border-top: 3px solid #1a3a6b;\n        }\n\n        .kpi-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 8px 16px rgba(15, 32, 68, 0.15);\n        }\n\n        .kpi-card.accent-1 {\n            border-top-color: #1a3a6b;\n        }\n\n        .kpi-card.accent-2 {\n            border-top-color: #0f2044;\n        }\n\n        .kpi-card.accent-3 {\n            border-top-color: #2d5a8e;\n        }\n\n        .kpi-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin-bottom: 1rem;\n        }\n\n        .kpi-title {\n            font-size: 0.9rem;\n            color: #6b7280;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n            font-weight: 500;\n        }\n\n        .kpi-icon {\n            width: 40px;\n            height: 40px;\n            background: linear-gradient(135deg, #1a3a6b 0%, #2d5a8e 100%);\n            border-radius: 10px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 1.2rem;\n            font-weight: bold;\n        }\n\n        .kpi-value {\n            font-size: 2.5rem;\n            font-weight: 700;\n            color: #1f2937;\n            margin-bottom: 0.5rem;\n        }\n\n        .kpi-change {\n            font-size: 0.9rem;\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .kpi-change.positive {\n            color: #10b981;\n        }\n\n        .kpi-change.negative {\n            color: #ef4444;\n        }\n\n        .kpi-change-icon {\n            font-weight: bold;\n        }\n\n        .quick-stats {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 1rem;\n            margin-top: 2rem;\n        }\n\n        .stat-item {\n            background: linear-gradient(135deg, #f7fafc 0%, #f0f4f8 100%);\n            padding: 1.25rem;\n            border-radius: 10px;\n            border: 1px solid #e5e7eb;\n        }\n\n        .stat-label {\n            font-size: 0.85rem;\n            color: #6b7280;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n        }\n\n        .stat-value {\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: #1a3a6b;\n        }\n\n        @media (max-width: 768px) {\n            .header {\n                padding: 1.5rem 1rem;\n            }\n\n            .logo {\n                font-size: 1.5rem;\n            }\n\n            .welcome-section {\n                padding: 1.5rem;\n            }\n\n            .welcome-section h1 {\n                font-size: 1.5rem;\n            }\n\n            .welcome-section p {\n                font-size: 1rem;\n            }\n\n            .kpi-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .kpi-value {\n                font-size: 2rem;\n            }\n\n            .quick-stats {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        .footer {\n            text-align: center;\n            padding: 2rem 1rem;\n            color: #6b7280;\n            font-size: 0.9rem;\n        }\n    </style>\n</head>\n<body>\n    <header class=\"header\">\n        <div class=\"header-content\">\n            <div class=\"logo\">Meridian Capital</div>\n            <div class=\"tagline\">Corporate Finance Analytics Platform</div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <section class=\"welcome-section\">\n            <h1>Welcome to Meridian Capital Analytics</h1>\n            <p>\n                Finance leaders face unprecedented challenges due to market volatility, rising prices and margin impact,\n                and geopolitical events. Disconnected data silos, legacy tools, and passive reporting do not provide\n                a unified, actionable view of financial health.\n            </p>\n            <p>\n                Meridian Capital delivers agentic analytics that unifies your financial data across the enterprise — giving\n                CFOs, FP&amp;A teams, and business unit leaders the real-time, AI-powered insights needed to act with\n                confidence in an uncertain environment.\n            </p>\n        </section>\n\n        <h2 class=\"section-title\">Key Performance Indicators</h2>\n\n        <div class=\"kpi-grid\">\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Total Revenue</div>\n                    <div class=\"kpi-icon\">$</div>\n                </div>\n                <div class=\"kpi-value\">$84.2B</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>6.3% vs last quarter</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">EBITDA Margin</div>\n                    <div class=\"kpi-icon\">%</div>\n                </div>\n                <div class=\"kpi-value\">28.7%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>+1.4pp vs last year</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Free Cash Flow</div>\n                    <div class=\"kpi-icon\">&#x1F4B5;</div>\n                </div>\n                <div class=\"kpi-value\">$12.1B</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>9.2% vs last quarter</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Gross Margin</div>\n                    <div class=\"kpi-icon\">&#x1F4CA;</div>\n                </div>\n                <div class=\"kpi-value\">61.4%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>+0.8pp vs last year</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Return on Equity</div>\n                    <div class=\"kpi-icon\">&#x1F4C8;</div>\n                </div>\n                <div class=\"kpi-value\">18.3%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>+2.1pp vs last year</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Operating Expenses</div>\n                    <div class=\"kpi-icon\">&#9881;</div>\n                </div>\n                <div class=\"kpi-value\">$18.6B</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9660;</span>\n                    <span>3.2% below target</span>\n                </div>\n            </div>\n        </div>\n\n        <h2 class=\"section-title\">Quick Statistics</h2>\n\n        <div class=\"quick-stats\">\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Business Units</div>\n                <div class=\"stat-value\">12</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Open Budget Lines</div>\n                <div class=\"stat-value\">847</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Variance Alerts</div>\n                <div class=\"stat-value\">23</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Forecast Accuracy</div>\n                <div class=\"stat-value\">94.1%</div>\n            </div>\n        </div>\n    </main>\n\n    <footer class=\"footer\">\n        <p>&copy; 2024 Meridian Capital. All rights reserved. | Corporate Finance Analytics</p>\n    </footer>\n</body>\n</html>",
