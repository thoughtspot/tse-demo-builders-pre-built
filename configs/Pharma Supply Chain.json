      "homePageType": "html",
      "homePageValue": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>RX Direct - Pharmacy Supply Chain Analytics</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background-color: #f7fafc;\n            color: #1f2937;\n            line-height: 1.6;\n        }\n\n        .header {\n            background: linear-gradient(135deg, #2563a3 0%, #3182ce 50%, #4a9ee5 100%);\n            color: white;\n            padding: 2rem 1rem;\n            box-shadow: 0 4px 6px rgba(49, 130, 206, 0.1);\n        }\n\n        .header-content {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .logo {\n            font-size: 2rem;\n            font-weight: 700;\n            margin-bottom: 0.5rem;\n            letter-spacing: -0.5px;\n        }\n\n        .tagline {\n            font-size: 1rem;\n            opacity: 0.95;\n            font-weight: 300;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n\n        .welcome-section {\n            background: white;\n            border-radius: 12px;\n            padding: 2.5rem;\n            margin-bottom: 2rem;\n            box-shadow: 0 2px 8px rgba(49, 130, 206, 0.08);\n            border-left: 4px solid #3182ce;\n        }\n\n        .welcome-section h1 {\n            color: #1f2937;\n            font-size: 2rem;\n            margin-bottom: 1rem;\n            font-weight: 600;\n        }\n\n        .welcome-section p {\n            color: #4b5563;\n            font-size: 1.1rem;\n            line-height: 1.8;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            font-size: 1.5rem;\n            color: #1f2937;\n            margin-bottom: 1.5rem;\n            font-weight: 600;\n            display: flex;\n            align-items: center;\n        }\n\n        .section-title::before {\n            content: '';\n            width: 4px;\n            height: 24px;\n            background: #3182ce;\n            margin-right: 12px;\n            border-radius: 2px;\n        }\n\n        .kpi-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 1.5rem;\n            margin-bottom: 2rem;\n        }\n\n        .kpi-card {\n            background: white;\n            border-radius: 12px;\n            padding: 1.75rem;\n            box-shadow: 0 2px 8px rgba(49, 130, 206, 0.08);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            border-top: 3px solid #3182ce;\n        }\n\n        .kpi-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 8px 16px rgba(49, 130, 206, 0.15);\n        }\n\n        .kpi-card.accent-1 {\n            border-top-color: #3182ce;\n        }\n\n        .kpi-card.accent-2 {\n            border-top-color: #2563a3;\n        }\n\n        .kpi-card.accent-3 {\n            border-top-color: #4a9ee5;\n        }\n\n        .kpi-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin-bottom: 1rem;\n        }\n\n        .kpi-title {\n            font-size: 0.9rem;\n            color: #6b7280;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n            font-weight: 500;\n        }\n\n        .kpi-icon {\n            width: 40px;\n            height: 40px;\n            background: linear-gradient(135deg, #3182ce 0%, #4a9ee5 100%);\n            border-radius: 10px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 1.2rem;\n            font-weight: bold;\n        }\n\n        .kpi-value {\n            font-size: 2.5rem;\n            font-weight: 700;\n            color: #1f2937;\n            margin-bottom: 0.5rem;\n        }\n\n        .kpi-change {\n            font-size: 0.9rem;\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .kpi-change.positive {\n            color: #10b981;\n        }\n\n        .kpi-change.negative {\n            color: #ef4444;\n        }\n\n        .kpi-change-icon {\n            font-weight: bold;\n        }\n\n        .quick-stats {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 1rem;\n            margin-top: 2rem;\n        }\n\n        .stat-item {\n            background: linear-gradient(135deg, #f7fafc 0%, #f5f5f5 100%);\n            padding: 1.25rem;\n            border-radius: 10px;\n            border: 1px solid #e5e7eb;\n        }\n\n        .stat-label {\n            font-size: 0.85rem;\n            color: #6b7280;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n        }\n\n        .stat-value {\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: #3182ce;\n        }\n\n        .cta-button {\n            display: inline-block;\n            background: linear-gradient(135deg, #2563a3 0%, #3182ce 50%, #4a9ee5 100%);\n            color: white;\n            padding: 0.875rem 2rem;\n            border-radius: 8px;\n            text-decoration: none;\n            font-weight: 600;\n            margin-top: 1rem;\n            transition: transform 0.2s ease, box-shadow 0.2s ease;\n            box-shadow: 0 4px 6px rgba(49, 130, 206, 0.2);\n        }\n\n        .cta-button:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 6px 12px rgba(49, 130, 206, 0.3);\n        }\n\n        @media (max-width: 768px) {\n            .header {\n                padding: 1.5rem 1rem;\n            }\n\n            .logo {\n                font-size: 1.5rem;\n            }\n\n            .welcome-section {\n                padding: 1.5rem;\n            }\n\n            .welcome-section h1 {\n                font-size: 1.5rem;\n            }\n\n            .welcome-section p {\n                font-size: 1rem;\n            }\n\n            .kpi-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .kpi-value {\n                font-size: 2rem;\n            }\n\n            .quick-stats {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        .footer {\n            text-align: center;\n            padding: 2rem 1rem;\n            color: #6b7280;\n            font-size: 0.9rem;\n        }\n    </style>\n</head>\n<body>\n    <header class=\"header\">\n        <div class=\"header-content\">\n            <div class=\"logo\">RX Direct</div>\n            <div class=\"tagline\">Pharmacy Supply Chain Analytics Platform</div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <section class=\"welcome-section\">\n            <h1>Welcome to RX Direct Analytics</h1>\n            <p>\n                Your comprehensive pharmacy supply chain management solution. Monitor real-time inventory levels, \n                track order fulfillment, and optimize your pharmaceutical distribution network with data-driven insights.\n            </p>\n            <p>\n                Our platform provides end-to-end visibility across your entire supply chain, helping you reduce costs, \n                improve efficiency, and ensure critical medications reach patients on time.\n            </p>\n        </section>\n\n        <h2 class=\"section-title\">Key Performance Indicators</h2>\n\n        <div class=\"kpi-grid\">\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Total Orders</div>\n                    <div class=\"kpi-icon\">📦</div>\n                </div>\n                <div class=\"kpi-value\">12,847</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>8.5% vs last month</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Fulfillment Rate</div>\n                    <div class=\"kpi-icon\">✓</div>\n                </div>\n                <div class=\"kpi-value\">98.2%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>2.1% vs last month</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Inventory Value</div>\n                    <div class=\"kpi-icon\">$</div>\n                </div>\n                <div class=\"kpi-value\">$2.4M</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>5.3% vs last month</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Avg Delivery Time</div>\n                    <div class=\"kpi-icon\">⏱</div>\n                </div>\n                <div class=\"kpi-value\">18.5h</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▼</span>\n                    <span>12% faster than target</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Active Suppliers</div>\n                    <div class=\"kpi-icon\">🏢</div>\n                </div>\n                <div class=\"kpi-value\">247</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>15 new this month</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Stock Accuracy</div>\n                    <div class=\"kpi-icon\">🎯</div>\n                </div>\n                <div class=\"kpi-value\">99.7%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>0.5% improvement</span>\n                </div>\n            </div>\n        </div>\n\n        <h2 class=\"section-title\">Quick Statistics</h2>\n\n        <div class=\"quick-stats\">\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Pending Orders</div>\n                <div class=\"stat-value\">342</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Low Stock Items</div>\n                <div class=\"stat-value\">28</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Today's Shipments</div>\n                <div class=\"stat-value\">156</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Active Pharmacies</div>\n                <div class=\"stat-value\">1,834</div>\n            </div>\n        </div>\n    </main>\n\n    <footer class=\"footer\">\n        <p>&copy; 2024 RX Direct. All rights reserved. | Pharmacy Supply Chain Analytics</p>\n    </footer>\n</body>\n</html>",
