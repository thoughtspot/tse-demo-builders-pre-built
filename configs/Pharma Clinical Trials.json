      "homePageType": "html",
      "homePageValue": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>TrialView - Clinical Trials Analytics</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background-color: #f0fdfa;\n            color: #1f2937;\n            line-height: 1.6;\n        }\n\n        .header {\n            background: linear-gradient(135deg, #0f766e 0%, #0d9488 50%, #2dd4bf 100%);\n            color: white;\n            padding: 2rem 1rem;\n            box-shadow: 0 4px 6px rgba(15, 118, 110, 0.1);\n        }\n\n        .header-content {\n            max-width: 1200px;\n            margin: 0 auto;\n        }\n\n        .logo {\n            font-size: 2rem;\n            font-weight: 700;\n            margin-bottom: 0.5rem;\n            letter-spacing: -0.5px;\n        }\n\n        .tagline {\n            font-size: 1rem;\n            opacity: 0.95;\n            font-weight: 300;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n\n        .welcome-section {\n            background: white;\n            border-radius: 12px;\n            padding: 2.5rem;\n            margin-bottom: 2rem;\n            box-shadow: 0 2px 8px rgba(15, 118, 110, 0.08);\n            border-left: 4px solid #0d9488;\n        }\n\n        .welcome-section h1 {\n            color: #1f2937;\n            font-size: 2rem;\n            margin-bottom: 1rem;\n            font-weight: 600;\n        }\n\n        .welcome-section p {\n            color: #4b5563;\n            font-size: 1.1rem;\n            line-height: 1.8;\n            margin-bottom: 1rem;\n        }\n\n        .section-title {\n            font-size: 1.5rem;\n            color: #1f2937;\n            margin-bottom: 1.5rem;\n            font-weight: 600;\n            display: flex;\n            align-items: center;\n        }\n\n        .section-title::before {\n            content: '';\n            width: 4px;\n            height: 24px;\n            background: #0d9488;\n            margin-right: 12px;\n            border-radius: 2px;\n        }\n\n        .kpi-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 1.5rem;\n            margin-bottom: 2rem;\n        }\n\n        .kpi-card {\n            background: white;\n            border-radius: 12px;\n            padding: 1.75rem;\n            box-shadow: 0 2px 8px rgba(15, 118, 110, 0.08);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            border-top: 3px solid #0d9488;\n        }\n\n        .kpi-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 8px 16px rgba(15, 118, 110, 0.15);\n        }\n\n        .kpi-card.accent-1 {\n            border-top-color: #0d9488;\n        }\n\n        .kpi-card.accent-2 {\n            border-top-color: #0f766e;\n        }\n\n        .kpi-card.accent-3 {\n            border-top-color: #2dd4bf;\n        }\n\n        .kpi-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin-bottom: 1rem;\n        }\n\n        .kpi-title {\n            font-size: 0.9rem;\n            color: #6b7280;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n            font-weight: 500;\n        }\n\n        .kpi-icon {\n            width: 40px;\n            height: 40px;\n            background: linear-gradient(135deg, #0d9488 0%, #2dd4bf 100%);\n            border-radius: 10px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 1.2rem;\n            font-weight: bold;\n        }\n\n        .kpi-value {\n            font-size: 2.5rem;\n            font-weight: 700;\n            color: #1f2937;\n            margin-bottom: 0.5rem;\n        }\n\n        .kpi-change {\n            font-size: 0.9rem;\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .kpi-change.positive {\n            color: #10b981;\n        }\n\n        .kpi-change.negative {\n            color: #ef4444;\n        }\n\n        .kpi-change-icon {\n            font-weight: bold;\n        }\n\n        .quick-stats {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 1rem;\n            margin-top: 2rem;\n        }\n\n        .stat-item {\n            background: linear-gradient(135deg, #f0fdfa 0%, #e6fffa 100%);\n            padding: 1.25rem;\n            border-radius: 10px;\n            border: 1px solid #99f6e4;\n        }\n\n        .stat-label {\n            font-size: 0.85rem;\n            color: #6b7280;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n        }\n\n        .stat-value {\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: #0d9488;\n        }\n\n        .footer {\n            text-align: center;\n            padding: 2rem 1rem;\n            color: #6b7280;\n            font-size: 0.9rem;\n        }\n\n        @media (max-width: 768px) {\n            .header {\n                padding: 1.5rem 1rem;\n            }\n\n            .logo {\n                font-size: 1.5rem;\n            }\n\n            .welcome-section {\n                padding: 1.5rem;\n            }\n\n            .welcome-section h1 {\n                font-size: 1.5rem;\n            }\n\n            .welcome-section p {\n                font-size: 1rem;\n            }\n\n            .kpi-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .kpi-value {\n                font-size: 2rem;\n            }\n\n            .quick-stats {\n                grid-template-columns: 1fr;\n            }\n        }\n    </style>\n</head>\n<body>\n    <header class=\"header\">\n        <div class=\"header-content\">\n            <div class=\"logo\">TrialView</div>\n            <div class=\"tagline\">Clinical Trials Analytics Platform</div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <section class=\"welcome-section\">\n            <h1>Welcome to TrialView Analytics</h1>\n            <p>\n                Your clinical trials intelligence platform. Monitor study activities across the full pipeline &mdash;\n                tracking what&rsquo;s recruiting, what&rsquo;s completing, and where capacity is concentrated.\n                Gain real-time visibility into enrollment health, phase progression, and sponsor engagement.\n            </p>\n            <p>\n                Identify pipeline gaps before they become delays, assess intervention types that drive the most\n                trial volume, and surface the sponsor sources powering your organization&rsquo;s research portfolio.\n            </p>\n        </section>\n\n        <h2 class=\"section-title\">Key Performance Indicators</h2>\n\n        <div class=\"kpi-grid\">\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Active Studies</div>\n                    <div class=\"kpi-icon\">&#x1F52C;</div>\n                </div>\n                <div class=\"kpi-value\">847</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>12.3% vs last quarter</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Enrollment Rate</div>\n                    <div class=\"kpi-icon\">%</div>\n                </div>\n                <div class=\"kpi-value\">76.4%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>4.2% above target</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Recruiting Sites</div>\n                    <div class=\"kpi-icon\">&#x1F3E5;</div>\n                </div>\n                <div class=\"kpi-value\">312</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>18 new this quarter</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Avg Trial Duration</div>\n                    <div class=\"kpi-icon\">&#x23F1;</div>\n                </div>\n                <div class=\"kpi-value\">14.2mo</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9660;</span>\n                    <span>8% faster than prior cohort</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Unique Sponsors</div>\n                    <div class=\"kpi-icon\">&#x1F3E2;</div>\n                </div>\n                <div class=\"kpi-value\">94</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>7 new this year</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Phase Completion Rate</div>\n                    <div class=\"kpi-icon\">&#x1F3AF;</div>\n                </div>\n                <div class=\"kpi-value\">68.0%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">&#9650;</span>\n                    <span>3.1% vs prior year</span>\n                </div>\n            </div>\n        </div>\n\n        <h2 class=\"section-title\">Quick Statistics</h2>\n\n        <div class=\"quick-stats\">\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Pending IRB Review</div>\n                <div class=\"stat-value\">43</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Phase I Active</div>\n                <div class=\"stat-value\">128</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">New Enrollments (30d)</div>\n                <div class=\"stat-value\">2,847</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Multi-Site Trials</div>\n                <div class=\"stat-value\">203</div>\n            </div>\n        </div>\n    </main>\n\n    <footer class=\"footer\">\n        <p>&copy; 2024 TrialView. All rights reserved. | Pharma Clinical Trials Analytics</p>\n    </footer>\n</body>\n</html>",
