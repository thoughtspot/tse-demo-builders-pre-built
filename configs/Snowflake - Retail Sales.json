      "homePageValue": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Retail Analytics Dashboard</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background-color: #f5f3ff;\n            color: #1f2937;\n            line-height: 1.6;\n            min-height: 100vh;\n        }\n\n        .header {\n            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);\n            color: white;\n            padding: 2rem 1rem;\n            box-shadow: 0 4px 6px rgba(124, 58, 237, 0.1);\n        }\n\n        .header-content {\n            max-width: 1400px;\n            margin: 0 auto;\n        }\n\n        .header h1 {\n            font-size: 2.5rem;\n            font-weight: 700;\n            margin-bottom: 0.5rem;\n        }\n\n        .header p {\n            font-size: 1.1rem;\n            opacity: 0.95;\n        }\n\n        .container {\n            max-width: 1400px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n\n        .tabs {\n            display: flex;\n            gap: 0.5rem;\n            margin-bottom: 2rem;\n            flex-wrap: wrap;\n            background: white;\n            padding: 0.5rem;\n            border-radius: 12px;\n            box-shadow: 0 2px 8px rgba(124, 58, 237, 0.08);\n        }\n\n        .tab {\n            flex: 1;\n            min-width: 200px;\n            padding: 1rem 1.5rem;\n            background: white;\n            border: 2px solid #e9d5ff;\n            border-radius: 8px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            text-align: center;\n            font-weight: 600;\n            color: #1f2937;\n        }\n\n        .tab:hover {\n            border-color: #7c3aed;\n            background: #faf5ff;\n        }\n\n        .tab.active {\n            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);\n            color: white;\n            border-color: #7c3aed;\n            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);\n        }\n\n        .tab-content {\n            display: none;\n        }\n\n        .tab-content.active {\n            display: block;\n            animation: fadeIn 0.4s ease;\n        }\n\n        @keyframes fadeIn {\n            from {\n                opacity: 0;\n                transform: translateY(10px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .kpi-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 1.5rem;\n            margin-bottom: 2rem;\n        }\n\n        .kpi-card {\n            background: white;\n            padding: 1.5rem;\n            border-radius: 12px;\n            box-shadow: 0 2px 8px rgba(124, 58, 237, 0.08);\n            border: 1px solid #e9d5ff;\n            transition: all 0.3s ease;\n        }\n\n        .kpi-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 8px 16px rgba(124, 58, 237, 0.15);\n            border-color: #7c3aed;\n        }\n\n        .kpi-label {\n            font-size: 0.875rem;\n            color: #6b7280;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n            margin-bottom: 0.5rem;\n            font-weight: 600;\n        }\n\n        .kpi-value {\n            font-size: 2.25rem;\n            font-weight: 700;\n            color: #7c3aed;\n            margin-bottom: 0.5rem;\n        }\n\n        .kpi-change {\n            font-size: 0.875rem;\n            display: inline-flex;\n            align-items: center;\n            padding: 0.25rem 0.75rem;\n            border-radius: 20px;\n            font-weight: 600;\n        }\n\n        .kpi-change.positive {\n            background: #dcfce7;\n            color: #166534;\n        }\n\n        .kpi-change.negative {\n            background: #fee2e2;\n            color: #991b1b;\n        }\n\n        .chart-card {\n            background: white;\n            padding: 2rem;\n            border-radius: 12px;\n            box-shadow: 0 2px 8px rgba(124, 58, 237, 0.08);\n            border: 1px solid #e9d5ff;\n            margin-bottom: 1.5rem;\n        }\n\n        .chart-header {\n            margin-bottom: 1.5rem;\n        }\n\n        .chart-title {\n            font-size: 1.25rem;\n            font-weight: 700;\n            color: #1f2937;\n            margin-bottom: 0.25rem;\n        }\n\n        .chart-subtitle {\n            font-size: 0.875rem;\n            color: #6b7280;\n        }\n\n        .chart-placeholder {\n            height: 300px;\n            background: linear-gradient(135deg, #faf5ff 0%, #f5f3ff 100%);\n            border-radius: 8px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            border: 2px dashed #e9d5ff;\n            color: #7c3aed;\n            font-weight: 600;\n        }\n\n        .data-table {\n            width: 100%;\n            border-collapse: collapse;\n            background: white;\n        }\n\n        .data-table th {\n            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);\n            color: white;\n            padding: 1rem;\n            text-align: left;\n            font-weight: 600;\n            font-size: 0.875rem;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n        }\n\n        .data-table td {\n            padding: 1rem;\n            border-bottom: 1px solid #e9d5ff;\n        }\n\n        .data-table tr:hover {\n            background: #faf5ff;\n        }\n\n        .metric-badge {\n            display: inline-block;\n            padding: 0.25rem 0.75rem;\n            border-radius: 20px;\n            font-size: 0.875rem;\n            font-weight: 600;\n        }\n\n        .metric-badge.high {\n            background: #dcfce7;\n            color: #166534;\n        }\n\n        .metric-badge.medium {\n            background: #fef3c7;\n            color: #92400e;\n        }\n\n        .metric-badge.low {\n            background: #fee2e2;\n            color: #991b1b;\n        }\n\n        .insight-card {\n            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);\n            color: white;\n            padding: 1.5rem;\n            border-radius: 12px;\n            margin-bottom: 1.5rem;\n            box-shadow: 0 4px 12px rgba(124, 58, 237, 0.2);\n        }\n\n        .insight-title {\n            font-size: 1.125rem;\n            font-weight: 700;\n            margin-bottom: 0.5rem;\n        }\n\n        .insight-text {\n            opacity: 0.95;\n            line-height: 1.6;\n        }\n\n        .grid-2 {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));\n            gap: 1.5rem;\n            margin-bottom: 1.5rem;\n        }\n\n        @media (max-width: 768px) {\n            .header h1 {\n                font-size: 1.75rem;\n            }\n\n            .header p {\n                font-size: 1rem;\n            }\n\n            .tab {\n                min-width: 150px;\n                padding: 0.75rem 1rem;\n                font-size: 0.875rem;\n            }\n\n            .kpi-value {\n                font-size: 1.75rem;\n            }\n\n            .grid-2 {\n                grid-template-columns: 1fr;\n            }\n\n            .chart-placeholder {\n                height: 200px;\n            }\n        }\n\n        .segment-card {\n            background: white;\n            padding: 1.5rem;\n            border-radius: 12px;\n            border-left: 4px solid #7c3aed;\n            box-shadow: 0 2px 8px rgba(124, 58, 237, 0.08);\n            margin-bottom: 1rem;\n        }\n\n        .segment-name {\n            font-size: 1.125rem;\n            font-weight: 700;\n            color: #7c3aed;\n            margin-bottom: 0.75rem;\n        }\n\n        .segment-stats {\n            display: flex;\n            gap: 2rem;\n            flex-wrap: wrap;\n        }\n\n        .segment-stat {\n            flex: 1;\n            min-width: 120px;\n        }\n\n        .segment-stat-label {\n            font-size: 0.75rem;\n            color: #6b7280;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n            margin-bottom: 0.25rem;\n        }\n\n        .segment-stat-value {\n            font-size: 1.25rem;\n            font-weight: 700;\n            color: #1f2937;\n        }\n\n        .filter-bar {\n            background: white;\n            padding: 1rem;\n            border-radius: 8px;\n            margin-bottom: 1.5rem;\n            display: flex;\n            gap: 1rem;\n            flex-wrap: wrap;\n            align-items: center;\n            box-shadow: 0 2px 8px rgba(124, 58, 237, 0.08);\n        }\n\n        .filter-label {\n            font-weight: 600;\n            color: #1f2937;\n        }\n\n        .filter-button {\n            padding: 0.5rem 1rem;\n            border: 2px solid #e9d5ff;\n            background: white;\n            border-radius: 6px;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            font-weight: 500;\n            color: #1f2937;\n        }\n\n        .filter-button:hover {\n            border-color: #7c3aed;\n            background: #faf5ff;\n        }\n\n        .filter-button.active {\n            background: #7c3aed;\n            color: white;\n            border-color: #7c3aed;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"header\">\n        <div class=\"header-content\">\n            <h1>Retail Analytics Dashboard</h1>\n            <p>Comprehensive insights for retail performance, merchandising, and customer analytics</p>\n        </div>\n    </div>\n\n    <div class=\"container\">\n        <div class=\"tabs\">\n            <div class=\"tab active\" onclick=\"switchTab(0)\">\n                Executive KPIs\n            </div>\n            <div class=\"tab\" onclick=\"switchTab(1)\">\n                Store Performance\n            </div>\n            <div class=\"tab\" onclick=\"switchTab(2)\">\n                Category Management\n            </div>\n            <div class=\"tab\" onclick=\"switchTab(3)\">\n                Customer Analysis\n            </div>\n        </div>\n\n        <!-- Executive KPIs Tab -->\n        <div class=\"tab-content active\">\n            <div class=\"insight-card\">\n                <div class=\"insight-title\">📊 Executive Summary</div>\n                <div class=\"insight-text\">\n                    Overall performance is trending positive with 8.3% YoY sales growth. Focus areas: Increase average basket size through cross-selling initiatives and optimize high-margin categories to improve gross profit margins.\n                </div>\n            </div>\n\n            <div class=\"kpi-grid\">\n                <div class=\"kpi-card\">\n                    <div class=\"kpi-label\">Total Sales</div>\n                    <div class=\"kpi-value\">$24.8M</div>\n                    <span class=\"kpi-change positive\">↑ 8.3% vs LY</span>\n                </div>\n                <div class=\"kpi-card\">\n                    <div class=\"kpi-label\">Gross Profit</div>\n                    <div class=\"kpi-value\">$9.2M</div>\n                    <span class=\"kpi-change positive\">↑ 6.7% vs LY</span>\n                </div>\n                <div class=\"kpi-card\">\n                    <div class=\"kpi-label\">Gross Margin</div>\n                    <div class=\"kpi-value\">37.1%</div>\n                    <span class=\"kpi-change negative\">↓ 0.6% vs LY</span>\n                </div>\n                <div class=\"kpi-card\">\n                    <div class=\"kpi-label\">Transactions</div>\n                    <div class=\"kpi-value\">186.4K</div>\n                    <span class=\"kpi-change positive\">↑ 12.1% vs LY</span>\n                </div>\n                <div class=\"kpi-card\">\n                    <div class=\"kpi-label\">Avg Transaction Size</div>\n                    <div class=\"kpi-value\">$133.02</div>\n                    <span class=\"kpi-change negative\">↓ 3.4% vs LY</span>\n                </div>\n                <div class=\"kpi-card\">\n                    <div class=\"kpi-label\">Avg Basket Size</div>\n                    <div class=\"kpi-value\">4.2 items</div>\n                    <span class=\"kpi-change positive\">↑ 2.4% vs LY</span>\n                </div>\n            </div>\n\n            <div class=\"grid-2\">\n                <div class=\"chart-card\">\n                    <div class=\"chart-header\">\n                        <div class=\"chart-title\">Sales Trend</div>\n                        <div class=\"chart-subtitle\">Monthly performance over last 12 months</div>\n                    </div>\n                    <div class=\"chart-placeholder\">Sales Trend Visualization</div>\n                </div>\n                <div class=\"chart-card\">\n                    <div class=\"chart-header\">\n                        <div class=\"chart-title\">Margin Analysis</div>\n                        <div class=\"chart-subtitle\">Gross margin trends by month</div>\n                    </div",
