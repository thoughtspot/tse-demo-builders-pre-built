      "homePageType": "html",
      "homePageValue": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Apex Capital - Banking Portfolio Analytics</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n            background-color: #f8fafc;\n            color: #1f2937;\n            line-height: 1.6;\n        }\n\n        .header {\n            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 60%, #1d4ed8 100%);\n            color: white;\n            padding: 2rem 1rem;\n            box-shadow: 0 4px 6px rgba(15, 23, 42, 0.2);\n        }\n\n        .header-content {\n            max-width: 1200px;\n            margin: 0 auto;\n            display: flex;\n            align-items: center;\n            gap: 1rem;\n        }\n\n        .logo-mark {\n            width: 48px;\n            height: 48px;\n            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);\n            border-radius: 10px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            font-weight: 800;\n            color: #0f172a;\n            flex-shrink: 0;\n        }\n\n        .logo-text {\n            font-size: 1.75rem;\n            font-weight: 700;\n            margin-bottom: 0.2rem;\n            letter-spacing: -0.5px;\n        }\n\n        .tagline {\n            font-size: 0.95rem;\n            opacity: 0.85;\n            font-weight: 300;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 2rem 1rem;\n        }\n\n        .welcome-section {\n            background: white;\n            border-radius: 12px;\n            padding: 2.5rem;\n            margin-bottom: 2rem;\n            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);\n            border-left: 4px solid #1e3a8a;\n        }\n\n        .welcome-section h1 {\n            color: #0f172a;\n            font-size: 1.75rem;\n            margin-bottom: 1rem;\n            font-weight: 600;\n        }\n\n        .welcome-section p {\n            color: #4b5563;\n            font-size: 1.05rem;\n            line-height: 1.8;\n            margin-bottom: 1rem;\n        }\n\n        .scenario-highlight {\n            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);\n            border: 1px solid #bfdbfe;\n            border-radius: 8px;\n            padding: 1.25rem 1.5rem;\n            margin-top: 1rem;\n            font-style: italic;\n            color: #1e3a8a;\n            font-size: 1rem;\n        }\n\n        .section-title {\n            font-size: 1.4rem;\n            color: #0f172a;\n            margin-bottom: 1.5rem;\n            font-weight: 600;\n            display: flex;\n            align-items: center;\n        }\n\n        .section-title::before {\n            content: '';\n            width: 4px;\n            height: 24px;\n            background: linear-gradient(180deg, #1e3a8a 0%, #f59e0b 100%);\n            margin-right: 12px;\n            border-radius: 2px;\n        }\n\n        .kpi-grid {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n            gap: 1.5rem;\n            margin-bottom: 2rem;\n        }\n\n        .kpi-card {\n            background: white;\n            border-radius: 12px;\n            padding: 1.75rem;\n            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.07);\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\n            border-top: 3px solid #1e3a8a;\n        }\n\n        .kpi-card:hover {\n            transform: translateY(-4px);\n            box-shadow: 0 8px 16px rgba(15, 23, 42, 0.12);\n        }\n\n        .kpi-card.accent-1 {\n            border-top-color: #1e3a8a;\n        }\n\n        .kpi-card.accent-2 {\n            border-top-color: #0f172a;\n        }\n\n        .kpi-card.accent-3 {\n            border-top-color: #f59e0b;\n        }\n\n        .kpi-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: flex-start;\n            margin-bottom: 1rem;\n        }\n\n        .kpi-title {\n            font-size: 0.85rem;\n            color: #6b7280;\n            text-transform: uppercase;\n            letter-spacing: 0.5px;\n            font-weight: 500;\n        }\n\n        .kpi-icon {\n            width: 40px;\n            height: 40px;\n            background: linear-gradient(135deg, #1e3a8a 0%, #1d4ed8 100%);\n            border-radius: 10px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            color: white;\n            font-size: 1.1rem;\n            font-weight: bold;\n        }\n\n        .kpi-card.accent-3 .kpi-icon {\n            background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);\n        }\n\n        .kpi-value {\n            font-size: 2.5rem;\n            font-weight: 700;\n            color: #0f172a;\n            margin-bottom: 0.5rem;\n        }\n\n        .kpi-change {\n            font-size: 0.875rem;\n            display: flex;\n            align-items: center;\n            gap: 0.5rem;\n        }\n\n        .kpi-change.positive {\n            color: #10b981;\n        }\n\n        .kpi-change.negative {\n            color: #ef4444;\n        }\n\n        .kpi-change-icon {\n            font-weight: bold;\n        }\n\n        .insight-banner {\n            background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);\n            color: white;\n            border-radius: 12px;\n            padding: 2rem;\n            margin-bottom: 2rem;\n            display: flex;\n            align-items: center;\n            gap: 2rem;\n        }\n\n        .insight-icon {\n            width: 56px;\n            height: 56px;\n            background: rgba(245, 158, 11, 0.2);\n            border: 2px solid #f59e0b;\n            border-radius: 12px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 1.5rem;\n            flex-shrink: 0;\n        }\n\n        .insight-text h3 {\n            font-size: 1.1rem;\n            font-weight: 600;\n            margin-bottom: 0.4rem;\n            color: #f59e0b;\n        }\n\n        .insight-text p {\n            font-size: 0.95rem;\n            opacity: 0.85;\n            line-height: 1.6;\n        }\n\n        .quick-stats {\n            display: grid;\n            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n            gap: 1rem;\n            margin-top: 2rem;\n        }\n\n        .stat-item {\n            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);\n            padding: 1.25rem;\n            border-radius: 10px;\n            border: 1px solid #e2e8f0;\n        }\n\n        .stat-label {\n            font-size: 0.85rem;\n            color: #6b7280;\n            margin-bottom: 0.5rem;\n            font-weight: 500;\n        }\n\n        .stat-value {\n            font-size: 1.5rem;\n            font-weight: 700;\n            color: #1e3a8a;\n        }\n\n        @media (max-width: 768px) {\n            .header {\n                padding: 1.5rem 1rem;\n            }\n\n            .logo-text {\n                font-size: 1.35rem;\n            }\n\n            .welcome-section {\n                padding: 1.5rem;\n            }\n\n            .welcome-section h1 {\n                font-size: 1.35rem;\n            }\n\n            .kpi-grid {\n                grid-template-columns: 1fr;\n            }\n\n            .kpi-value {\n                font-size: 2rem;\n            }\n\n            .insight-banner {\n                flex-direction: column;\n                gap: 1rem;\n            }\n\n            .quick-stats {\n                grid-template-columns: 1fr;\n            }\n        }\n\n        .footer {\n            text-align: center;\n            padding: 2rem 1rem;\n            color: #6b7280;\n            font-size: 0.9rem;\n        }\n    </style>\n</head>\n<body>\n    <header class=\"header\">\n        <div class=\"header-content\">\n            <div class=\"logo-mark\">A</div>\n            <div>\n                <div class=\"logo-text\">Apex Capital</div>\n                <div class=\"tagline\">Banking Portfolio &amp; Deposit Analytics Platform</div>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <section class=\"welcome-section\">\n            <h1>Welcome to Apex Capital Analytics</h1>\n            <p>\n                As a banking executive, you're facing pressure to grow deposits, expand wallet share, and optimize \n                your customer portfolio mix. Traditional reporting shows what happened — Apex Capital Analytics \n                helps you understand the <em>why</em> behind performance trends and explore what-if scenarios in real-time.\n            </p>\n            <p>\n                Move beyond static dashboards to conversational analytics. Ask questions in plain language, \n                drill into any segment, and surface actionable insights that drive strategic decisions.\n            </p>\n            <div class=\"scenario-highlight\">\n                \"Which customer segments are growing deposits fastest, and what's the cross-sell opportunity within our top 20% by AUM?\"\n            </div>\n        </section>\n\n        <div class=\"insight-banner\">\n            <div class=\"insight-icon\">💡</div>\n            <div class=\"insight-text\">\n                <h3>AI-Powered Strategic Intelligence</h3>\n                <p>Use Ask Apex to explore deposit trends, wallet share gaps, and portfolio concentration risk — all in natural language. No SQL, no waiting for the data team.</p>\n            </div>\n        </div>\n\n        <h2 class=\"section-title\">Key Performance Indicators</h2>\n\n        <div class=\"kpi-grid\">\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Total Deposits</div>\n                    <div class=\"kpi-icon\">$</div>\n                </div>\n                <div class=\"kpi-value\">$48.3B</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>6.2% vs prior quarter</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Wallet Share</div>\n                    <div class=\"kpi-icon\">%</div>\n                </div>\n                <div class=\"kpi-value\">34.7%</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>1.4 pts vs prior quarter</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Net Interest Margin</div>\n                    <div class=\"kpi-icon\">↗</div>\n                </div>\n                <div class=\"kpi-value\">3.18%</div>\n                <div class=\"kpi-change negative\">\n                    <span class=\"kpi-change-icon\">▼</span>\n                    <span>0.06 pts vs prior quarter</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-1\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Assets Under Management</div>\n                    <div class=\"kpi-icon\">⬆</div>\n                </div>\n                <div class=\"kpi-value\">$112.6B</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>9.1% YoY growth</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-2\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Customer Lifetime Value</div>\n                    <div class=\"kpi-icon\">★</div>\n                </div>\n                <div class=\"kpi-value\">$24,180</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>11.3% vs prior year</span>\n                </div>\n            </div>\n\n            <div class=\"kpi-card accent-3\">\n                <div class=\"kpi-header\">\n                    <div class=\"kpi-title\">Products per Customer</div>\n                    <div class=\"kpi-icon\">#</div>\n                </div>\n                <div class=\"kpi-value\">3.4</div>\n                <div class=\"kpi-change positive\">\n                    <span class=\"kpi-change-icon\">▲</span>\n                    <span>0.3 vs prior quarter</span>\n                </div>\n            </div>\n        </div>\n\n        <h2 class=\"section-title\">Portfolio Snapshot</h2>\n\n        <div class=\"quick-stats\">\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">High-Value Customers</div>\n                <div class=\"stat-value\">18,240</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">At-Risk Deposit Accounts</div>\n                <div class=\"stat-value\">1,073</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">Cross-Sell Opportunities</div>\n                <div class=\"stat-value\">4,891</div>\n            </div>\n            <div class=\"stat-item\">\n                <div class=\"stat-label\">New Accounts (MTD)</div>\n                <div class=\"stat-value\">2,347</div>\n            </div>\n        </div>\n    </main>\n\n    <footer class=\"footer\">\n        <p>&copy; 2024 Apex Capital. All rights reserved. | Banking Portfolio Analytics</p>\n    </footer>\n</body>\n</html>",
